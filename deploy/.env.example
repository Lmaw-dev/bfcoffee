# Copy this file to .env and set the variables

# SSH target
REMOTE_USER=deploy
REMOTE_HOST=your.server.ip.or.domain
REMOTE_PORT=22

# Webroot on the server where files will be deployed
REMOTE_WEB_ROOT=/var/www/bfc

# Local paths (adjust if your repo layout differs)
LOCAL_REACT_APP=react-app
LOCAL_PHP_BACKEND=.

# MySQL credentials you will create on the server (example user/pass)
DB_NAME=web_system
DB_USER=jireh
DB_PASS=faith

# Optional: path to private ssh key
SSH_KEY=~/.ssh/id_rsa
